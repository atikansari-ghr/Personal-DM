[Unit]
Description=Personal Documents web (gunicorn)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=personaldocs
Group=personaldocs
EnvironmentFile=/etc/personaldocs/personaldocs.env
WorkingDirectory=/opt/personaldocs/current/backend
ExecStart=/opt/personaldocs/current/.venv/bin/gunicorn personaldocs.wsgi --config /opt/personaldocs/current/deployment/gunicorn.conf.py --bind ${PD_BIND} --timeout 900 --graceful-timeout 30 --max-requests 2000 --max-requests-jitter 200 --access-logfile - --forwarded-allow-ips ${PD_TRUSTED_PROXY_IPS}
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=40
UMask=0027
NoNewPrivileges=yes
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
