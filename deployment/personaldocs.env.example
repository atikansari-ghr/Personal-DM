# /etc/personaldocs/personaldocs.env — created by `personaldocs install`. Mode 0640 root:personaldocs.
# Do not commit a real copy of this file.

# Public HTTPS address served by Nginx Proxy Manager or Pangolin (no trailing slash)
PD_PUBLIC_ORIGIN=https://docs.example.com
PD_ALLOWED_HOSTS=docs.example.com,localhost,127.0.0.1
PD_BEHIND_PROXY=1
PD_TRUSTED_PROXY_IPS=127.0.0.1
# Optional plain-HTTP access from the home network (trusted LAN only): personaldocs local-access on
# PD_LOCAL_ORIGINS=http://192.168.1.50:8000

# Where gunicorn listens. Use 0.0.0.0:8000 when the reverse proxy runs on another host (and firewall the port).
PD_BIND=127.0.0.1:8000
PD_WEB_WORKERS=2

# Paths
PD_DATA_DIR=/var/lib/personaldocs
PD_CONFIG_DIR=/etc/personaldocs
PD_FRONTEND_DIST=/opt/personaldocs/current/frontend/dist

# PostgreSQL over the local Unix socket with peer authentication (no password)
PD_DB_NAME=personaldocs
PD_DB_USER=personaldocs
PD_DB_HOST=/var/run/postgresql
PD_DB_PASSWORD=

# Converter memory limit per process (MB)
PD_PROCESS_MEMORY_LIMIT_MB=1536
PD_LOG_LEVEL=INFO

# Installer/updater settings
PD_REPO_URL=https://github.com/OWNER/REPO.git
PD_BRANCH=main
# PD_GIT_SSH_KEY=/etc/personaldocs/deploy_key
