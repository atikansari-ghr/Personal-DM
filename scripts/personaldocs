#!/usr/bin/env bash
# personaldocs — install, upgrade, rollback, repair and operate Personal Documents on Debian 13 (native, no Docker).
#
#   personaldocs install [--public-origin URL] [--bind ADDR:PORT] [--ref REF] [--repo URL] [--build-frontend] [--with-verapdf]
#   personaldocs upgrade [--ref REF] [--skip-backup]
#   personaldocs rollback
#   personaldocs repair
#   personaldocs status | doctor | backup | integrity [...] | logs [web|worker|scheduler]
#   personaldocs restore BACKUP_DIR [--verify-only] [--no-key]
#   personaldocs recover-admin USERNAME [--generate] [--reset-totp]
#   personaldocs nas-apply [--from-settings]   (mount the NAS configured in Settings → Storage & backup)
#   personaldocs setup-token
#   personaldocs check-access                   (why the app is not reachable through the reverse proxy)
#   personaldocs local-access on|off|status     (also open the app at http://<container-ip>:<port> on the home network)
#   personaldocs access-policy status|off|rollback|trust-ip IP [--hours N]|unblock-ip IP|clear-automatic
#                                               (recover from a country/IP policy that locks you out)
#   personaldocs manage <django command> [...]
#
# Credentials for the private repository are read from /etc/personaldocs/github-token (fine-grained, read-only
# token) or an SSH deploy key (PD_GIT_SSH_KEY). They are never placed in URLs, arguments or logs.
set -Eeuo pipefail
umask 027
# Always run with a UTF-8 locale that exists on every Debian system. Containers often have LANG=C/POSIX
# (Proxmox console, pct enter) or an uninstalled locale forwarded by SSH (en_US.UTF-8, LC_CTYPE=UTF-8);
# PostgreSQL would then create an SQL_ASCII cluster, or fail to create one at all.
export LANG=C.UTF-8 LC_ALL=C.UTF-8
unset LANGUAGE LC_CTYPE LC_COLLATE LC_MESSAGES 2>/dev/null || true

APP=personaldocs
PREFIX=/opt/personaldocs
RELEASES=$PREFIX/releases
CURRENT=$PREFIX/current
MIRROR=$PREFIX/repo.git
CONF_DIR=/etc/personaldocs
ENV_FILE=$CONF_DIR/personaldocs.env
TOKEN_FILE=$CONF_DIR/github-token
DATA_DIR=/var/lib/personaldocs
LOG_DIR=/var/log/personaldocs
LOG=$LOG_DIR/install.log
LOCK=/run/personaldocs.lock
STATE=$PREFIX/state
UNITS=(personaldocs-web personaldocs-worker personaldocs-scheduler)
MIN_RAM_MB=1800
MIN_DISK_MB=4096

APT_PACKAGES=(
  python3 python3-venv python3-dev build-essential libpq-dev
  postgresql postgresql-client
  tesseract-ocr tesseract-ocr-eng tesseract-ocr-osd ocrmypdf ghostscript qpdf unpaper pngquant poppler-utils
  libreoffice-writer-nogui libreoffice-calc-nogui libreoffice-impress-nogui fonts-dejavu-core
  git curl ca-certificates jq util-linux rsync iproute2 nfs-common cifs-utils
)

# ------------------------------------------------------------------ helpers
c_ok() { printf '\033[32m%s\033[0m\n' "$*"; }
c_warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
c_err() { printf '\033[31m%s\033[0m\n' "$*" >&2; }
redact() { sed -E 's/(gh[pousr]_[A-Za-z0-9_]{10,}|github_pat_[A-Za-z0-9_]{20,})/[REDACTED]/g; s/(password|token|secret)=[^ ]*/\1=[REDACTED]/Ig'; }
log() { local m="[$(date -Is)] $*"; echo "$m" | redact; [ -d "$LOG_DIR" ] && echo "$m" | redact >>"$LOG" || true; }
die() { c_err "ERROR: $*"; log "ERROR: $*"; c_err "Details: $LOG. Fix the problem and run the same command again; completed steps are skipped safely."; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "run as root (sudo personaldocs $CMD)"; }
trap 'c_err "Failed at line $LINENO: $BASH_COMMAND"; log "failed at line $LINENO"' ERR

with_lock() {
  exec 9>"$LOCK"
  flock -n 9 || die "another personaldocs operation is running"
}

load_env() {
  if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
  fi
  PD_REPO_URL=${PD_REPO_URL:-}
  PD_BRANCH=${PD_BRANCH:-main}
  PD_BIND=${PD_BIND:-127.0.0.1:8000}
}

env_set() { # env_set KEY VALUE — idempotently write a key into the env file
  local k=$1 v=$2
  if grep -q "^$k=" "$ENV_FILE" 2>/dev/null; then
    sed -i "s|^$k=.*|$k=${v//|/\\|}|" "$ENV_FILE"
  else
    echo "$k=$v" >>"$ENV_FILE"
  fi
}

git_auth() { # run git with the stored credential, without exposing it
  if [ -n "${PD_GIT_SSH_KEY:-}" ]; then
    GIT_SSH_COMMAND="ssh -i $PD_GIT_SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new" git "$@"
  elif [ -f "$TOKEN_FILE" ]; then
    git -c credential.helper= -c "credential.helper=!f(){ echo username=x-access-token; printf 'password=%s\n' \"\$(cat $TOKEN_FILE)\"; }; f" "$@"
  else
    git "$@"
  fi
}

manage() { # run a Django management command as the service user with the protected env file
  local rel=${MANAGE_RELEASE:-$CURRENT}
  runuser -u $APP -- bash -c "set -a; . '$ENV_FILE'; set +a; export PD_FRONTEND_DIST='$rel/frontend/dist'; cd '$rel/backend' && exec '$rel/.venv/bin/python' manage.py \"\$@\"" _ "$@"
}

health() {
  local port=${PD_BIND##*:} host=${PD_BIND%:*}
  [ "$host" = "0.0.0.0" ] && host=127.0.0.1
  for _ in $(seq 1 30); do
    if curl -fsS "http://$host:$port/api/health" >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  return 1
}

version_of() { cat "$1/VERSION" 2>/dev/null || echo unknown; }

# ------------------------------------------------------------------ preflight
preflight() {
  log "preflight checks"
  . /etc/os-release
  [ "${ID:-}" = debian ] || c_warn "This installer targets Debian 13; detected ${PRETTY_NAME:-unknown}."
  [ "${VERSION_ID:-}" = 13 ] || c_warn "Debian 13 (trixie) is the tested target; detected ${VERSION_ID:-unknown}."
  case "$(uname -m)" in x86_64|aarch64) ;; *) die "unsupported architecture $(uname -m)";; esac
  command -v systemctl >/dev/null && [ -d /run/systemd/system ] || die "systemd is required"
  local ram disk
  ram=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
  [ "$ram" -ge "$MIN_RAM_MB" ] || die "at least ${MIN_RAM_MB} MB RAM required (found ${ram} MB)"
  mkdir -p "$(dirname "$DATA_DIR")"
  disk=$(df -Pm "$(dirname "$DATA_DIR")" | awk 'NR==2 {print $4}')
  [ "$disk" -ge "$MIN_DISK_MB" ] || die "at least ${MIN_DISK_MB} MB free disk required (found ${disk} MB)"
  getent hosts deb.debian.org >/dev/null || c_warn "DNS lookup of deb.debian.org failed; package installation may fail"
  local port=${PD_BIND##*:}
  if ss -ltn "sport = :$port" | grep -q LISTEN && ! systemctl is-active --quiet personaldocs-web; then
    die "port $port is already in use by another program (choose another with --bind)"
  fi
  c_ok "preflight OK (RAM ${ram} MB, free disk ${disk} MB)"
}

install_optional_packages() { # never fatal: the app works without them
  log "optional packages (GoAccess traffic analytics)"
  export DEBIAN_FRONTEND=noninteractive
  apt-get install -y -q --no-install-recommends goaccess >/dev/null 2>&1 || c_warn "GoAccess could not be installed; traffic analytics will use the built-in summary."
}

ensure_access_log() { # privacy-safe access log for traffic analytics + weekly rotation
  install -d -m 0750 -o $APP -g $APP "$DATA_DIR/logs"
  grep -q '^PD_ACCESS_LOG=' "$ENV_FILE" || echo "PD_ACCESS_LOG=$DATA_DIR/logs/access.log" >>"$ENV_FILE"
  if [ -d /etc/logrotate.d ]; then
    cat >/etc/logrotate.d/personaldocs <<EOF
$DATA_DIR/logs/*.log {
  weekly
  rotate 8
  compress
  delaycompress
  missingok
  notifempty
  create 0640 $APP $APP
  su $APP $APP
}
EOF
  fi
}

install_packages() {
  log "installing packages"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -q
  apt-get install -y -q --no-install-recommends "${APT_PACKAGES[@]}"
  if [ "${NEED_NODE:-0}" = 1 ]; then apt-get install -y -q --no-install-recommends nodejs npm; fi
  systemctl enable --now postgresql >/dev/null
}

ensure_user_dirs() {
  log "service account and directories"
  id $APP >/dev/null 2>&1 || useradd --system --home-dir "$DATA_DIR" --shell /usr/sbin/nologin $APP
  install -d -m 0750 -o root -g $APP "$CONF_DIR"
  install -d -m 0750 -o $APP -g $APP "$DATA_DIR" "$DATA_DIR/storage" "$DATA_DIR/storage/originals" "$DATA_DIR/storage/derivatives" \
    "$DATA_DIR/staging" "$DATA_DIR/tmp" "$DATA_DIR/exports" "$DATA_DIR/quarantine" "$DATA_DIR/pre-upgrade"
  install -d -m 0755 "$PREFIX" "$RELEASES" "$STATE"
  install -d -m 0750 "$LOG_DIR"
  if [ -f "$TOKEN_FILE" ]; then chmod 600 "$TOKEN_FILE"; chown root:root "$TOKEN_FILE"; fi
  fix_tool_permissions
}

ensure_config() {
  log "configuration"
  if [ ! -f "$ENV_FILE" ]; then
    install -m 0640 -o root -g $APP /dev/null "$ENV_FILE"
    cat >"$ENV_FILE" <<EOF
PD_PUBLIC_ORIGIN=${OPT_ORIGIN:-http://localhost:8000}
PD_ALLOWED_HOSTS=localhost,127.0.0.1
PD_BEHIND_PROXY=1
PD_TRUSTED_PROXY_IPS=127.0.0.1
PD_BIND=${OPT_BIND:-127.0.0.1:8000}
PD_WEB_WORKERS=2
PD_DATA_DIR=$DATA_DIR
PD_CONFIG_DIR=$CONF_DIR
PD_FRONTEND_DIST=$CURRENT/frontend/dist
PD_DB_NAME=personaldocs
PD_DB_USER=personaldocs
PD_DB_HOST=/var/run/postgresql
PD_DB_PASSWORD=
PD_PROCESS_MEMORY_LIMIT_MB=1536
PD_LOG_LEVEL=INFO
PD_REPO_URL=${OPT_REPO:-}
PD_BRANCH=${OPT_BRANCH:-main}
EOF
  fi
  [ -n "${OPT_ORIGIN:-}" ] && env_set PD_PUBLIC_ORIGIN "$OPT_ORIGIN" && env_set PD_ALLOWED_HOSTS "$(echo "$OPT_ORIGIN" | sed -E 's#^https?://##; s#/.*##; s#:.*##'),localhost,127.0.0.1"
  [ -n "${OPT_BIND:-}" ] && env_set PD_BIND "$OPT_BIND"
  grep -q '^LANG=' "$ENV_FILE" || echo 'LANG=C.UTF-8' >>"$ENV_FILE"   # OCR/LibreOffice/file names in the services
  [ -n "${OPT_REPO:-}" ] && env_set PD_REPO_URL "$OPT_REPO"
  if [ ! -s "$CONF_DIR/secret_key" ]; then
    install -m 0640 -o root -g $APP /dev/null "$CONF_DIR/secret_key"
    head -c 48 /dev/urandom | base64 | tr -d '\n=+/' >"$CONF_DIR/secret_key"
  fi
  chown root:$APP "$ENV_FILE" "$CONF_DIR/secret_key"
  chmod 0640 "$ENV_FILE" "$CONF_DIR/secret_key"
  load_env
}

ensure_database() {
  log "database"
  # A cluster whose creation failed during package installation (invalid locale) is created here.
  if ! pg_lsclusters -h 2>/dev/null | grep -q .; then
    local ver; ver=$(ls /usr/lib/postgresql 2>/dev/null | sort -V | tail -1)
    [ -n "$ver" ] || die "PostgreSQL is not installed"
    log "creating PostgreSQL $ver cluster (UTF-8)"
    pg_createcluster --locale C.UTF-8 --encoding UTF8 "$ver" main >/dev/null
  fi
  systemctl enable --now postgresql >/dev/null 2>&1 || true
  for _ in $(seq 1 30); do runuser -u postgres -- psql -tAc 'SELECT 1' >/dev/null 2>&1 && break; sleep 1; done
  runuser -u postgres -- psql -tAc 'SELECT 1' >/dev/null 2>&1 || die "PostgreSQL is not running; see: journalctl -u postgresql -n 50"
  runuser -u postgres -- psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='personaldocs'" | grep -q 1 ||
    runuser -u postgres -- psql -qc "CREATE ROLE personaldocs LOGIN"
  # The app needs a UTF-8 database. template0 + an explicit locale works even when the cluster itself was
  # initialised as SQL_ASCII (container without a locale when PostgreSQL was installed).
  local enc
  enc=$(runuser -u postgres -- psql -tAc "SELECT pg_encoding_to_char(encoding) FROM pg_database WHERE datname='personaldocs'")
  if [ -n "$enc" ] && [ "$enc" != UTF8 ]; then
    if [ "$(runuser -u postgres -- psql -d personaldocs -tAc "SELECT count(*) FROM pg_tables WHERE schemaname='public'")" = 0 ]; then
      log "recreating the empty personaldocs database as UTF-8 (was $enc)"
      runuser -u postgres -- dropdb personaldocs
      enc=""
    else
      die "database 'personaldocs' uses encoding $enc and already holds data; it must be UTF8 (dump, recreate as UTF8 and restore)"
    fi
  fi
  if [ -z "$enc" ]; then
    runuser -u postgres -- createdb -O personaldocs -E UTF8 -T template0 --lc-collate=C.UTF-8 --lc-ctype=C.UTF-8 personaldocs
  fi
}

# ------------------------------------------------------------------ releases
fetch_source() { # sets REV and REL_ID
  local ref=${OPT_REF:-${PD_BRANCH:-main}}
  if [ -n "${SRC_DIR:-}" ]; then
    REV=$(git -C "$SRC_DIR" rev-parse HEAD 2>/dev/null || echo local)
    REL_ID="$(version_of "$SRC_DIR")-${REV:0:10}"
    return
  fi
  [ -n "${PD_REPO_URL:-}" ] || die "PD_REPO_URL is not set (use --repo https://github.com/OWNER/REPO.git)"
  if [ ! -d "$MIRROR" ]; then
    log "cloning repository mirror"
    git_auth clone --quiet --mirror "$PD_REPO_URL" "$MIRROR" || die "could not clone the repository; check $TOKEN_FILE / deploy key"
  else
    git_auth --git-dir="$MIRROR" remote set-url origin "$PD_REPO_URL"
    git_auth --git-dir="$MIRROR" fetch --quiet --prune origin '+refs/*:refs/*' || die "git fetch failed; check credentials and network"
  fi
  REV=$(git --git-dir="$MIRROR" rev-parse --verify "$ref^{commit}" 2>/dev/null) || die "revision $ref not found"
  REL_ID="$(git --git-dir="$MIRROR" show "$REV:VERSION" 2>/dev/null | tr -d '\n' || echo 0)-${REV:0:10}"
}

build_release() { # creates $RELEASES/$REL_ID with venv and frontend
  # Built in its final location: virtualenv scripts (gunicorn, pip) hard-code their own path, so the
  # directory must never be renamed afterwards. ".complete" marks a finished build; anything else is redone.
  local dir=$RELEASES/$REL_ID
  if [ -f "$dir/.complete" ] && head -1 "$dir/.venv/bin/gunicorn" 2>/dev/null | grep -qF "$dir/.venv/"; then
    log "release $REL_ID already built"; echo "$dir"; return
  fi
  rm -rf "$dir" "$dir.tmp"
  mkdir -p "$dir"
  if [ -n "${SRC_DIR:-}" ]; then
    rsync -a --exclude .git --exclude node_modules --exclude .venv --exclude '__pycache__' "$SRC_DIR"/ "$dir"/
  else
    git --git-dir="$MIRROR" archive "$REV" | tar -x -C "$dir"
  fi
  echo "$REV" >"$dir/REVISION"
  log "creating Python environment for $REL_ID"
  python3 -m venv "$dir/.venv"
  "$dir/.venv/bin/python" -m pip install --quiet --upgrade pip >/dev/null
  "$dir/.venv/bin/python" -m pip install --quiet --no-cache-dir -r "$dir/backend/requirements.txt" || die "Python dependency installation failed"
  if [ ! -f "$dir/frontend/dist/index.html" ]; then
    fetch_frontend_asset "$dir" || build_frontend "$dir"
  fi
  [ -f "$dir/frontend/dist/index.html" ] || die "frontend assets missing"
  rm -rf "$dir/frontend/node_modules"
  chown -R root:$APP "$dir"
  chmod -R g+rX,o-rwx "$dir"
  touch "$dir/.complete"
  echo "$dir"
}

fetch_frontend_asset() { # download frontend-dist.tar.gz from the GitHub release for a tag (if any)
  local dest=$1 tag repo api asset_url hdr
  tag=$(git --git-dir="$MIRROR" describe --tags --exact-match "$REV" 2>/dev/null) || return 1
  [ -f "$TOKEN_FILE" ] || return 1
  repo=$(echo "$PD_REPO_URL" | sed -E 's#^https://github.com/##; s#^git@github.com:##; s#\.git$##')
  hdr=$(mktemp)
  printf 'Authorization: Bearer %s\n' "$(cat "$TOKEN_FILE")" >"$hdr"
  api=$(curl -fsS -H @"$hdr" -H "Accept: application/vnd.github+json" "https://api.github.com/repos/$repo/releases/tags/$tag" 2>/dev/null) || { rm -f "$hdr"; return 1; }
  asset_url=$(echo "$api" | jq -r '.assets[] | select(.name=="frontend-dist.tar.gz") | .url' | head -1)
  if [ -z "$asset_url" ]; then rm -f "$hdr"; return 1; fi
  log "downloading prebuilt frontend for $tag"
  curl -fsSL -H @"$hdr" -H "Accept: application/octet-stream" "$asset_url" -o "$dest/frontend-dist.tar.gz" || { rm -f "$hdr"; return 1; }
  rm -f "$hdr"
  mkdir -p "$dest/frontend" && tar -xzf "$dest/frontend-dist.tar.gz" -C "$dest/frontend" && rm -f "$dest/frontend-dist.tar.gz"
}

build_frontend() {
  local dir=$1
  log "building frontend locally (one-off; needs ~1 GB RAM)"
  command -v npm >/dev/null || apt-get install -y -q --no-install-recommends nodejs npm
  (cd "$dir/frontend" && npm ci --no-audit --no-fund --loglevel=error && npm run build --silent) || die "frontend build failed"
}

install_verapdf() { # optional reference PDF/A validator (Java, ~250 MB)
  [ -x /opt/verapdf/verapdf ] && { log "veraPDF already installed"; return; }
  log "installing veraPDF (optional PDF/A validator)"
  apt-get install -y -q --no-install-recommends default-jre-headless unzip
  local tmp; tmp=$(mktemp -d)
  curl -fsSL https://software.verapdf.org/releases/verapdf-installer.zip -o "$tmp/verapdf.zip" || die "veraPDF download failed"
  unzip -q "$tmp/verapdf.zip" -d "$tmp"
  cat >"$tmp/auto.xml" <<'XML'
<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<AutomatedInstallation langpack="eng">
  <com.izforge.izpack.panels.htmlhello.HTMLHelloPanel id="welcome"/>
  <com.izforge.izpack.panels.target.TargetPanel id="install_dir"><installpath>/opt/verapdf</installpath></com.izforge.izpack.panels.target.TargetPanel>
  <com.izforge.izpack.panels.packs.PacksPanel id="sdk_pack_select">
    <pack index="0" name="veraPDF GUI" selected="true"/>
    <pack index="1" name="veraPDF Batch files" selected="true"/>
    <pack index="2" name="veraPDF Validation model" selected="false"/>
    <pack index="3" name="veraPDF Documentation" selected="false"/>
    <pack index="4" name="veraPDF Sample Plugins" selected="false"/>
  </com.izforge.izpack.panels.packs.PacksPanel>
  <com.izforge.izpack.panels.install.InstallPanel id="install"/>
  <com.izforge.izpack.panels.finish.FinishPanel id="finish"/>
</AutomatedInstallation>
XML
  java -jar "$tmp"/verapdf-greenfield-*/verapdf-izpack-installer-*.jar "$tmp/auto.xml" >/dev/null || die "veraPDF installation failed"
  rm -rf "$tmp"
  fix_tool_permissions
  env_set PD_VERAPDF_CMD /opt/verapdf/verapdf
}

fix_tool_permissions() { # tools installed by root under umask 027 must be usable by the service account
  if [ -d /opt/verapdf ]; then chmod -R a+rX /opt/verapdf; fi
}

sandbox_supported() { # can systemd give services private mounts here? (needs nesting in an LXC)
  [ -n "${SANDBOX_OK:-}" ] || {
    if systemd-run --wait --quiet --collect -p PrivateTmp=yes -p ProtectSystem=full /bin/true >/dev/null 2>&1; then SANDBOX_OK=y; else SANDBOX_OK=n; fi
  }
  [ "$SANDBOX_OK" = y ]
}

install_units() {
  local src=${1:-$CURRENT}/deployment/systemd
  for u in "${UNITS[@]}"; do install -m 0644 "$src/$u.service" /etc/systemd/system/; done
  # Optional isolation (ProtectSystem/PrivateTmp) only where mount namespaces work, otherwise the services cannot start.
  if [ -f "$src/hardening.conf" ] && sandbox_supported; then
    for u in "${UNITS[@]}"; do install -d /etc/systemd/system/$u.service.d; install -m 0644 "$src/hardening.conf" /etc/systemd/system/$u.service.d/10-hardening.conf; done
  else
    for u in "${UNITS[@]}"; do rm -f /etc/systemd/system/$u.service.d/10-hardening.conf; done
    [ -f "$src/hardening.conf" ] && c_warn "This container does not allow mount namespaces, so the services run without the extra systemd isolation. For more isolation enable Proxmox: container -> Options -> Features -> Nesting, then run: personaldocs repair"
  fi
  # NAS connection from Settings: a root path unit runs `personaldocs nas-apply` when the app requests a mount
  if [ -f "$src/personaldocs-nas.path" ]; then
    install -m 0644 "$src/personaldocs-nas.path" "$src/personaldocs-nas.service" /etc/systemd/system/
    install -d -m 0750 -o $APP -g $APP "$DATA_DIR/nas"
  fi
  systemctl daemon-reload
  [ -f /etc/systemd/system/personaldocs-nas.path ] && systemctl enable --now personaldocs-nas.path >/dev/null 2>&1 || true
}

show_web_failure() { # print the last service messages so the cause is visible without a second command
  c_err "Last messages from personaldocs-web:"
  journalctl -u personaldocs-web -n 25 --no-pager -o cat 2>/dev/null | redact >&2 || true
}

cmd_nas_apply() { # root: apply the NAS settings saved in the app (mount /mnt/pdnas)
  need_root; load_env
  [ -L "$CURRENT" ] || die "not installed"
  if [ ! -f "$DATA_DIR/nas/request.json" ] || [ "${1:-}" = "--from-settings" ]; then
    manage nas_request || die "the NAS settings are incomplete or invalid (Settings → Storage & backup)"
  fi
  local rc=0
  "$CURRENT/.venv/bin/python" "$CURRENT/backend/apps/ops/nas_helper.py" --data-dir "$DATA_DIR" || rc=$?
  manage nas_request --sync >/dev/null 2>&1 || true
  return $rc
}

ensure_key() {
  if [ ! -s "$CONF_DIR/encryption.key" ]; then
    log "creating encryption key for integration secrets"
    install -m 0600 -o $APP -g $APP /dev/null "$CONF_DIR/encryption.key"
    "$1/.venv/bin/python" -c 'from cryptography.fernet import Fernet;import sys;sys.stdout.write(Fernet.generate_key().decode())' >"$CONF_DIR/encryption.key"
  fi
  chown $APP:$APP "$CONF_DIR/encryption.key"
  chmod 0600 "$CONF_DIR/encryption.key"
}

activate() { # activate RELEASE_DIR
  local dir=$1
  if [ -L "$CURRENT" ] && [ "$(readlink -f "$CURRENT")" != "$dir" ]; then readlink -f "$CURRENT" >"$STATE/previous"; fi
  ln -sfn "$dir" "$CURRENT.new" && mv -T "$CURRENT.new" "$CURRENT"
  echo "$dir" >"$STATE/current"
}

prune_releases() {
  local keep=3 cur prev
  cur=$(readlink -f "$CURRENT" 2>/dev/null || true)
  prev=$(cat "$STATE/previous" 2>/dev/null || true)
  ls -1dt "$RELEASES"/*/ 2>/dev/null | sed 's#/$##' | tail -n +$((keep + 1)) | while read -r d; do
    [ "$d" = "$cur" ] || [ "$d" = "$prev" ] || rm -rf "$d"
  done
}

db_snapshot() { # quick local DB dump used for schema rollback
  local f="$DATA_DIR/pre-upgrade/db-$(date +%Y%m%d-%H%M%S).pgdump"
  runuser -u $APP -- pg_dump --format=custom --no-owner -h /var/run/postgresql personaldocs -f "$f" || die "pre-upgrade database dump failed"
  ls -1t "$DATA_DIR"/pre-upgrade/db-*.pgdump | tail -n +4 | xargs -r rm -f
  echo "$f"
}

schema_compatible() { # schema_compatible RELEASE_DIR — every applied migration of our apps exists in that release
  local dir=$1 applied missing=0
  applied=$(runuser -u $APP -- psql -h /var/run/postgresql -tA personaldocs -c \
    "SELECT app||'/'||name FROM django_migrations WHERE app IN ('core','accounts','library','notify','mailimport','ops')")
  while read -r m; do
    [ -z "$m" ] && continue
    [ -f "$dir/backend/apps/${m%%/*}/migrations/${m##*/}.py" ] || { missing=1; log "migration $m unknown to $(basename "$dir")"; }
  done <<<"$applied"
  return $missing
}

# ------------------------------------------------------------------ commands
cmd_install() {
  need_root; mkdir -p "$LOG_DIR"; with_lock
  load_env
  OPT_BIND=${OPT_BIND:-}; [ -n "$OPT_BIND" ] && PD_BIND=$OPT_BIND
  log "=== install started ($(date))"
  preflight
  [ "${OPT_BUILD_FRONTEND:-0}" = 1 ] && NEED_NODE=1
  install_packages
  install_optional_packages
  ensure_user_dirs
  ensure_config
  ensure_access_log
  ensure_database
  [ "${OPT_VERAPDF:-0}" = 1 ] && install_verapdf
  if [ -z "${PD_REPO_URL:-}" ] && [ -z "${OPT_REPO:-}" ]; then
    local here origin
    here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
    origin=$(git -C "$here" remote get-url origin 2>/dev/null || true)
    if [ -n "$origin" ] && [[ "$origin" != *@*:*@* ]] && [[ "$origin" != *://*:*@* ]]; then
      PD_REPO_URL=$origin; env_set PD_REPO_URL "$origin"
      [ -z "$OPT_REF" ] && OPT_REF=$(git -C "$here" rev-parse HEAD)
      log "using repository $origin (from the bootstrap checkout)"
    else
      SRC_DIR=$here
      log "no repository URL configured; installing from local source $SRC_DIR (upgrades need PD_REPO_URL)"
    fi
  fi
  fetch_source
  local dir; dir=$(build_release | tail -1)
  ensure_key "$dir"
  MANAGE_RELEASE=$dir manage migrate --noinput
  MANAGE_RELEASE=$dir manage check --deploy --fail-level ERROR >/dev/null 2>&1 || MANAGE_RELEASE=$dir manage check
  activate "$dir"
  install -m 0755 "$dir/scripts/personaldocs" /usr/local/bin/personaldocs
  install_units "$dir"
  for u in "${UNITS[@]}"; do systemctl enable --now "$u" >/dev/null; systemctl restart "$u"; done
  health || { show_web_failure; die "the web service did not become healthy; see: journalctl -u personaldocs-web -n 50"; }
  prune_releases
  log "=== install complete: $(version_of "$dir") ($REV)"
  c_ok "Personal Documents $(version_of "$dir") is installed and running on $PD_BIND."
  if [ "${PD_QUIET_TOKEN:-0}" = 1 ]; then
    :  # the guided installer prints the setup code in its own summary
  elif manage shell -c "from apps.accounts.models import SetupState; import sys; sys.exit(0 if SetupState.get().completed_at else 1)" 2>/dev/null; then
    echo "Setup already completed."
  else
    echo; manage setup_token; echo
  fi
  echo "Next: configure your reverse proxy for $(grep ^PD_PUBLIC_ORIGIN "$ENV_FILE" | cut -d= -f2-), then open it in a browser."
}

cmd_upgrade() {
  need_root; with_lock; load_env
  [ -L "$CURRENT" ] || die "not installed (run personaldocs install)"
  local old new snap
  old=$(readlink -f "$CURRENT")
  log "=== upgrade started from $(basename "$old")"
  local disk; disk=$(df -Pm "$DATA_DIR" | awk 'NR==2 {print $4}')
  [ "$disk" -ge 2048 ] || die "less than 2 GB free; free space before upgrading"
  fix_tool_permissions
  install_optional_packages
  ensure_access_log
  fetch_source
  new=$(build_release | tail -1)
  if [ "$new" = "$old" ]; then c_ok "Already at $(basename "$new")."; return; fi
  if [ "${OPT_SKIP_BACKUP:-0}" != 1 ]; then
    if manage shell -c "from apps.core import config; import sys; sys.exit(0 if config.get('backup.target') else 1)" 2>/dev/null; then
      log "pre-upgrade application backup"
      manage backup || die "pre-upgrade backup failed (fix the NAS or rerun with --skip-backup if you have a verified backup)"
    else
      c_warn "No backup destination configured: only a local database snapshot is taken."
    fi
  fi
  snap=$(db_snapshot)
  log "database snapshot: $snap"
  MANAGE_RELEASE=$new manage check >/dev/null || die "new release failed its checks; nothing was changed"
  systemctl stop personaldocs-scheduler personaldocs-worker
  if ! MANAGE_RELEASE=$new manage migrate --noinput; then
    c_err "Migration failed. Restoring the database snapshot and restarting the previous release."
    runuser -u $APP -- pg_restore --clean --if-exists --no-owner -h /var/run/postgresql -d personaldocs "$snap" || true
    systemctl start personaldocs-worker personaldocs-scheduler
    die "upgrade aborted; previous release still active"
  fi
  activate "$new"
  install -m 0755 "$new/scripts/personaldocs" /usr/local/bin/personaldocs
  install_units "$new"
  for u in "${UNITS[@]}"; do systemctl restart "$u"; done
  if ! health; then
    c_err "Health check failed after upgrade."; show_web_failure
    if schema_compatible "$old"; then
      activate "$old"; install_units "$old"; for u in "${UNITS[@]}"; do systemctl restart "$u"; done
      die "rolled back to $(basename "$old") (schema compatible)"
    fi
    die "the new schema is not compatible with $(basename "$old"); restore with: pg_restore from $snap or personaldocs restore <backup>"
  fi
  prune_releases
  log "=== upgrade complete: $(basename "$old") -> $(basename "$new")"
  c_ok "Upgraded $(version_of "$old") -> $(version_of "$new") ($(cat "$new/REVISION" | cut -c1-10))."
}

cmd_rollback() {
  need_root; with_lock; load_env
  local prev; prev=$(cat "$STATE/previous" 2>/dev/null || true)
  [ -n "$prev" ] && [ -d "$prev" ] || die "no previous release recorded"
  schema_compatible "$prev" || die "database contains migrations unknown to $(basename "$prev"); restore the pre-upgrade backup instead"
  local cur; cur=$(readlink -f "$CURRENT")
  activate "$prev"; install_units "$prev"
  for u in "${UNITS[@]}"; do systemctl restart "$u"; done
  health || { show_web_failure; die "previous release is not healthy"; }
  c_ok "Rolled back $(basename "$cur") -> $(basename "$prev")."
}

cmd_repair() {
  need_root; with_lock; load_env
  log "=== repair started"
  echo "Diagnosis before repair:"; cmd_doctor_inner || true
  install_packages
  install_optional_packages
  ensure_user_dirs
  ensure_config
  ensure_access_log
  ensure_database
  [ -L "$CURRENT" ] || die "no active release; run personaldocs install"
  ensure_key "$(readlink -f "$CURRENT")"
  chown -R $APP:$APP "$DATA_DIR"
  find "$DATA_DIR/storage/originals" -type f -exec chmod 0440 {} + 2>/dev/null || true
  install_units
  manage migrate --noinput
  manage shell -c "from apps.core.models import Job; from django.utils import timezone; print('requeued', Job.objects.filter(status='running', locked_until__lt=timezone.now()).update(status='queued'))"
  manage reindex
  for u in "${UNITS[@]}"; do systemctl enable "$u" >/dev/null; systemctl restart "$u"; done
  health || { show_web_failure; die "web service still unhealthy; see journalctl -u personaldocs-web"; }
  c_ok "Repair complete. No data, keys or accounts were reset."
}

cmd_status() {
  load_env
  echo "Version:  $(version_of "$(readlink -f "$CURRENT" 2>/dev/null || echo /nonexistent)") ($(cat "$CURRENT/REVISION" 2>/dev/null | cut -c1-10))"
  for u in "${UNITS[@]}"; do printf '%-26s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || true)"; done
  if health; then c_ok "Health:   OK ($PD_BIND)"; else c_err "Health:   FAILED"; fi
}

cmd_doctor_inner() { manage doctor; }

cmd_local_access() { # local-access on|off|status — opt-in plain-HTTP access from the home network
  need_root; load_env
  local port=${PD_BIND##*:} bindhost=${PD_BIND%:*} ip origin
  ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  case "${1:-status}" in
    on)
      [ "$bindhost" != 127.0.0.1 ] && [ "$bindhost" != localhost ] || die "the app only listens on 127.0.0.1; reinstall with --bind 0.0.0.0:$port first"
      [ -n "$ip" ] || die "could not determine this container's IP address"
      origin="http://$ip:$port"
      env_set PD_LOCAL_ORIGINS "$origin"
      systemctl restart personaldocs-web
      health || { show_web_failure; die "the web service did not come back"; }
      c_ok "Home-network access enabled: $origin"
      c_warn "This address uses plain HTTP: anyone on your home network could read the traffic. Use it only on a trusted network;"
      c_warn "camera upload, installing as an app and offline copies need the HTTPS address (${PD_PUBLIC_ORIGIN:-})."
      c_warn "Give the container a fixed IP (DHCP reservation); if it changes, run 'personaldocs local-access on' again." ;;
    off)
      sed -i '/^PD_LOCAL_ORIGINS=/d' "$ENV_FILE"
      systemctl restart personaldocs-web
      c_ok "Home-network access disabled; the app is only available at ${PD_PUBLIC_ORIGIN:-the public address}." ;;
    status)
      if [ -n "${PD_LOCAL_ORIGINS:-}" ]; then echo "Home-network access: on ($PD_LOCAL_ORIGINS)"; else echo "Home-network access: off (enable with: personaldocs local-access on)"; fi ;;
    *) die "usage: personaldocs local-access on|off|status" ;;
  esac
}

policy_note() { # policy changes take effect within 15 s (per-process cache); restart to apply at once
  systemctl restart personaldocs-web >/dev/null 2>&1 || true
}

cmd_check_access() { # explain, step by step, why the app is (not) reachable through the reverse proxy
  load_env
  local origin domain port bindhost myip proxy="" proxy_ip="" bad=0 code ips pubip
  origin=${PD_PUBLIC_ORIGIN:-}; domain=$(echo "$origin" | sed -E 's#^https?://##; s#/.*##; s#:.*##')
  port=${PD_BIND##*:}; bindhost=${PD_BIND%:*}
  myip=$(hostname -I 2>/dev/null | awk '{print $1}')
  if [ -r "$CONF_DIR/install-answers.env" ]; then
    proxy=$(sed -n 's/^PD_PROXY=//p' "$CONF_DIR/install-answers.env" | tr -d "'\"")
    proxy_ip=$(sed -n 's/^PD_PROXY_IP=//p' "$CONF_DIR/install-answers.env" | tr -d "'\"")
  fi
  ok_() { printf '  \033[32m✔\033[0m %s\n' "$*"; }
  bad_() { printf '  \033[31m✘\033[0m %s\n' "$1"; [ -n "${2:-}" ] && printf '      → %s\n' "$2"; bad=$((bad+1)); }
  info_() { printf '  • %s\n' "$*"; }
  echo "Access check for $origin  (container ${myip:-?}, app port $port)"
  echo "1. The app inside this container"
  local u; for u in "${UNITS[@]}"; do
    if systemctl is-active --quiet "$u"; then ok_ "$u running"; else bad_ "$u is not running" "journalctl -u $u -n 50 --no-pager   (then: personaldocs repair)"; fi
  done
  if health; then ok_ "app answers on http://127.0.0.1:$port"; else bad_ "the app does not answer locally" "journalctl -u personaldocs-web -n 50 --no-pager"; fi
  echo "2. Reachable from the proxy"
  if [ "$bindhost" = 127.0.0.1 ] || [ "$bindhost" = localhost ]; then
    if [ "$proxy" = 3 ]; then ok_ "listens on 127.0.0.1 (proxy runs in this container)"
    else bad_ "the app only listens on 127.0.0.1, so a proxy on another machine cannot reach it" "personaldocs install --bind 0.0.0.0:$port   (or re-run easy-install.sh)"; fi
  else
    if ! command -v ss >/dev/null; then info_ "configured to listen on $bindhost:$port (install iproute2 to verify)"
    elif ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "(^|:|\])$port\$"; then ok_ "listening on $bindhost:$port"
    else bad_ "nothing listens on port $port" "personaldocs repair"; fi
  fi
  if command -v nft >/dev/null && nft list table inet personaldocs >/dev/null 2>&1; then
    local allowed; allowed=$(nft list table inet personaldocs 2>/dev/null | grep -o 'saddr != {[^}]*}' | head -1)
    info_ "firewall rule active: port $port only from ${allowed#saddr != }"
    if [ -n "$proxy_ip" ] && ! nft list table inet personaldocs | grep -q "$proxy_ip"; then
      bad_ "the firewall does not allow the proxy $proxy_ip" "re-run easy-install.sh with the correct proxy IP, or: nft delete table inet personaldocs"
    fi
    info_ "if the proxy connects from a different IP than ${proxy_ip:-configured} (Newt/Pangolin, Docker, VPN), it is blocked → remove with: nft delete table inet personaldocs; rm /etc/nftables.d/personaldocs.nft"
  else
    ok_ "no Personal Documents firewall rule (port $port open to the network)"
  fi
  if grep -q "^PD_ALLOWED_HOSTS=.*$domain" "$ENV_FILE" 2>/dev/null; then ok_ "$domain is an allowed host name"
  else bad_ "$domain is not in PD_ALLOWED_HOSTS" "personaldocs install --public-origin $origin"; fi
  echo "   Proxy target to configure:  http://${myip:-<container-ip>}:$port   (test from the proxy machine: curl -H \"Host: $domain\" http://${myip:-<container-ip>}:$port/api/health ; calling it by IP without the Host header gives \"Bad Request (400)\", which is normal)"
  if [ -n "${PD_LOCAL_ORIGINS:-}" ]; then info_ "home-network access is on: $PD_LOCAL_ORIGINS"; else info_ "to open the app by IP on your home network: personaldocs local-access on"; fi
  echo "3. Public DNS for $domain (asked via Cloudflare DNS-over-HTTPS)"
  ips=$(curl -fsS -m 10 -H 'accept: application/dns-json' "https://cloudflare-dns.com/dns-query?name=$domain&type=A" 2>/dev/null | grep -o '"data":"[0-9.]*"' | cut -d'"' -f4 | tr '\n' ' ')
  if [ -z "$ips" ]; then
    bad_ "$domain has no public DNS A record" "create an A record (or CNAME) for $domain at your DNS provider pointing to the public IP of your proxy (home router for NPM, the VPS for Pangolin)"
  else
    ok_ "$domain → $ips"
    if echo "$ips" | grep -qE '(^| )(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)'; then
      info_ "that is a private address: only works inside your home network (or with local DNS)"
    fi
    pubip=$(curl -fsS -m 8 https://api.ipify.org 2>/dev/null || true)
    if [ -n "$pubip" ]; then
      if echo " $ips " | grep -q " $pubip "; then info_ "it points to this network's public IP ($pubip): the router must forward TCP 80 and 443 to the Nginx Proxy Manager host"
      elif [ "$proxy" != 2 ]; then info_ "this network's public IP is $pubip, which is not in the DNS answer; correct for Pangolin/a VPS, otherwise update the DNS record"; fi
    fi
  fi
  echo "4. HTTPS on $origin"
  code=$(curl -sS -o /dev/null -m 15 -w '%{http_code}' "$origin/api/health" 2>/tmp/pd-access.err || true)
  case "$code" in
    200) ok_ "$origin/api/health answers 200: the app is reachable through the proxy" ;;
    502|503|504) bad_ "the proxy answers $code: it cannot reach the app" "set the proxy target to http://${myip:-<container-ip>}:$port and check the firewall above" ;;
    404) bad_ "$domain answers, but not with this app (HTTP $code)" "create the proxy host for $domain → http://${myip:-<container-ip>}:$port (NPM: Hosts → Proxy Hosts; Pangolin: Resources)" ;;
    400) bad_ "the app rejects the host name (400)" "the proxy must pass the original Host header (NPM does by default); check PD_ALLOWED_HOSTS" ;;
    000|"")
      local err; err=$(tr -d '\r' </tmp/pd-access.err | tail -1)
      case "$err" in
        *"resolve host"*) bad_ "this container cannot resolve $domain" "DNS record missing (see 3), or the container's DNS server cannot see it" ;;
        *"timed out"*|*"Timeout"*) bad_ "connection to $domain timed out" "router port forwarding of 80/443 to the proxy, the proxy host firewall, or no NAT loopback on the router (then test from a phone on mobile data)" ;;
        *"refused"*) bad_ "connection to $domain refused" "the proxy is not listening on 443 at that address: check the NPM/Pangolin host and port forwarding" ;;
        *"SSL"*|*"certificate"*) bad_ "HTTPS certificate problem for $domain" "in NPM: SSL tab → request a Let's Encrypt certificate for exactly $domain (needs port 80 reachable)" ;;
        *) bad_ "$domain could not be reached: ${err:-unknown error}" "check DNS, port forwarding and the proxy host" ;;
      esac ;;
    *) info_ "$origin/api/health answered HTTP $code" ;;
  esac
  rm -f /tmp/pd-access.err
  echo
  if [ "$bad" -eq 0 ]; then c_ok "No problems found."; else c_err "$bad problem(s) found; fix them in the order shown."; return 1; fi
}

usage() { sed -n '2,/^set -Eeuo/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'; }

CMD=${1:-help}; shift || true
OPT_VERAPDF=0; OPT_REF=""; OPT_ORIGIN=""; OPT_BIND=""; OPT_REPO=""; OPT_SKIP_BACKUP=0; OPT_BUILD_FRONTEND=0; ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --ref) OPT_REF=$2; shift 2;;
    --public-origin) OPT_ORIGIN=${2%/}; shift 2;;
    --bind) OPT_BIND=$2; shift 2;;
    --repo) OPT_REPO=$2; PD_REPO_URL=$2; shift 2;;
    --branch) OPT_BRANCH=$2; shift 2;;
    --skip-backup) OPT_SKIP_BACKUP=1; shift;;
    --build-frontend) OPT_BUILD_FRONTEND=1; shift;;
    --with-verapdf) OPT_VERAPDF=1; shift;;
    *) ARGS+=("$1"); shift;;
  esac
done

case "$CMD" in
  install) cmd_install;;
  upgrade) cmd_upgrade;;
  rollback) cmd_rollback;;
  repair) cmd_repair;;
  status) cmd_status;;
  doctor) need_root; load_env; manage doctor || exit 1;;   # failed checks are listed above; not a script error
  backup) need_root; load_env; manage backup;;
  integrity) need_root; load_env; manage integrity "${ARGS[@]}";;
  restore)
    need_root; load_env; with_lock
    [ ${#ARGS[@]} -ge 1 ] || die "usage: personaldocs restore BACKUP_DIR [--verify-only] [--no-key]"
    if printf '%s\n' "${ARGS[@]}" | grep -qx -- --verify-only; then manage restore "${ARGS[@]}"; exit; fi
    read -rp "This replaces the current database with the backup. Type RESTORE to continue: " ans
    [ "$ans" = RESTORE ] || die "cancelled"
    systemctl stop "${UNITS[@]}"
    manage restore "${ARGS[@]}" --yes
    manage migrate --noinput
    systemctl start "${UNITS[@]}"
    health && c_ok "Restore complete and healthy." || die "restored, but the web service is unhealthy";;
  recover-admin) need_root; load_env; manage recover_admin "${ARGS[@]}";;
  nas-apply) cmd_nas_apply "${ARGS[@]}";;
  setup-token) need_root; load_env; manage setup_token;;
  check-access) need_root; cmd_check_access || exit 1;;
  local-access) cmd_local_access "${ARGS[@]}";;
  access-policy) need_root; load_env; manage access_policy "${ARGS[@]}"; policy_note;;
  logs) journalctl -f -u "personaldocs-${ARGS[0]:-web}";;
  manage) need_root; load_env; manage "${ARGS[@]}";;
  help|-h|--help) usage;;
  *) usage; exit 2;;
esac
